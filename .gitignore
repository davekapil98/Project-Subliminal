.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Secrets and machine-local environment configuration.
.env
.env.*
*.env
.envrc
.direnv/
credentials*.json
secrets*.json
*.pem
*.key

# Generated datasets and training artifacts. Only documentation, placeholders,
# and small reviewed metadata under manifests/splits are admitted to Git.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/manifests/**
!/data/splits/**
/artifacts/**
!/artifacts/**/
!/artifacts/**/.gitkeep
!/artifacts/**/README.md

# Alternate output roots used by common training and experiment tools.
/dataset/
/datasets/
/output/
/outputs/
/runs/
/checkpoints/
/recordings/
/wandb/
/mlruns/
/lightning_logs/
/tensorboard/

# Model weights, array dumps, dataset containers, and recorded media are never
# source-controlled, even if they are written outside the standard roots.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.arrow
*.tfrecord
*.mp4
*.avi
*.mkv

# Local editor, operating-system, and runtime files.
.idea/
.vscode/
.DS_Store
*.log
